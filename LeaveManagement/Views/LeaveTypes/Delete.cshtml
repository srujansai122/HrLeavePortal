@model LeaveManagement.Models.LeaveTypes.LeaveTypeViewModel

@{
    ViewData["Title"] = "Delete Leave Type";
}

<h1 class="mb-4 text-danger">@ViewData["Title"]</h1>

<div class="card shadow-sm">
    <div class="card-header bg-danger text-white">
        <h4 class="mb-0">Are you sure you want to delete this?</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3 fw-bold">
                @Html.DisplayNameFor(model => model.Name)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Name)
            </dd>

            <dt class="col-sm-3 fw-bold">
                @Html.DisplayNameFor(model => model.NumberOfDays)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.NumberOfDays)
            </dd>
        </dl>
    </div>
    <div class="card-footer d-flex justify-content-between">
        <form asp-action="Delete" class="d-inline">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">🗑️ Confirm Delete</button>
        </form>
        <a asp-action="Index" class="btn btn-secondary">⬅ Back to List</a>
    </div>
</div>
