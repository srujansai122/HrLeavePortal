@model LeaveManagement.Models.LeaveTypes.CreateLeaveTypeViewModel

@{
    ViewData["Title"] = "Create Leave Type";
}

<h1 class="mb-4 text-success">@ViewData["Title"]</h1>

<div class="card shadow-sm">
    <div class="card-header bg-success text-white">
        <h4 class="mb-0">Add a New Leave Type</h4>
    </div>
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="Enter leave type name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NumberOfDays" class="form-label"></label>
                <input asp-for="NumberOfDays" class="form-control" placeholder="Enter number of days" />
                <span asp-validation-for="NumberOfDays" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">⬅ Back to List</a>
                <button type="submit" class="btn btn-primary">➕ Create</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
