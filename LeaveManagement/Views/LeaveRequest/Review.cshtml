@model LeaveManagement.Models.LeaveRequests.ReviewLeaveRequestViewModel

@{
    ViewData["Title"] = "Review Leave Request";
}

<h2>Review Leave Request</h2>

<div class="card mb-4">
    <div class="card-header">
        <strong>Employee Information</strong>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">First Name</dt>
            <dd class="col-sm-9">@Model.employeesListViewModel.FirstName</dd>

            <dt class="col-sm-3">Last Name</dt>
            <dd class="col-sm-9">@Model.employeesListViewModel.LastName</dd>

            <dt class="col-sm-3">Date of Birth</dt>
            <dd class="col-sm-9">@Model.employeesListViewModel.dateOfBirth.ToString("dd MMM yyyy")</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.employeesListViewModel.Email</dd>
        </dl>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <strong>Leave Request Details</strong>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Start Date</dt>
            <dd class="col-sm-9">@Model.StartDate.ToDateTime(TimeOnly.MinValue).ToString("dd MMM yyyy")</dd>

            <dt class="col-sm-3">End Date</dt>
            <dd class="col-sm-9">@Model.EndDate.ToDateTime(TimeOnly.MinValue).ToString("dd MMM yyyy")</dd>

            <dt class="col-sm-3">Number of Days</dt>
            <dd class="col-sm-9">@Model.NumberOfDays</dd>

            <dt class="col-sm-3">Leave Type</dt>
            <dd class="col-sm-9">@Model.LeaveType</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.LeaveRequestStatus == "Approved")
                {
                    <span class="badge bg-success">Approved</span>
                }
                else if (Model.LeaveRequestStatus == "Pending")
                {
                    <span class="badge bg-warning text-dark">Pending</span>
                }
                else if (Model.LeaveRequestStatus == "Denied")
                {
                    <span class="badge bg-danger">Rejected</span>
                }
                else
                {
                    <span class="badge bg-secondary">@Model.LeaveRequestStatus</span>
                }
            </dd>

            <dt class="col-sm-3">Comments</dt>
            <dd class="col-sm-9">@Model.RequestComments</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <form asp-action="Approve" method="post" class="d-inline">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-success">Approve</button>
    </form>

    <form asp-action="Reject" method="post" class="d-inline">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger">Reject</button>
    </form>

    <a asp-action="ListRequests" class="btn btn-secondary">Back to List</a>
</div>
